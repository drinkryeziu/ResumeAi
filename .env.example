# Database — leave unset to run on the in-memory demo store (no Postgres needed)
DATABASE_URL="postgresql://user:password@localhost:5432/applyai"

# AI — provider per workflow is set in src/server/ai/routing.ts.
# With no keys set, every workflow falls back to the mock provider.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_FORCE_MOCK="false"

# Auth (phase 2)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""
EMAIL_SERVER=""
EMAIL_FROM="ApplyAI <hello@example.com>"

# Storage (phase 2) — any S3-compatible bucket
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Billing (phase 5)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
